# Django Configuration
# Generate a secure SECRET_KEY using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-in-production

# Set to False for production
DEBUG=False

# Add your domain(s) here for production
ALLOWED_HOSTS=localhost 127.0.0.1 nerzhaveyka.kg www.nerzhaveyka.kg

# Database Configuration
# Choose database engine: sqlite or postgresql
DATABASE_ENGINE=postgresql

# PostgreSQL Configuration (if DATABASE_ENGINE=postgresql)
POSTGRES_DB=nerzhaveyka_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Localization
LANGUAGE_CODE=ru-ru
TIME_ZONE=Asia/Bishkek

# Email Configuration (опционально)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
